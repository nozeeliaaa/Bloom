rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getRole() {
      return getUserData().profile.role;
    }

    function isAdmin() {
      return isAuth() &&
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }

    function hasActiveRelationship(teenUid, guardianUid) {
      return exists(/databases/$(database)/documents/relationships/$(teenUid + "_" + guardianUid)) &&
        get(/databases/$(database)/documents/relationships/$(teenUid + "_" + guardianUid)).data.status == "active";
    }

    // ─── users/{uid} ────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);

      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role"])
        // 🚫 Prevent sleepScore from being written in wrong place
        && (
          !("healthProfile" in request.resource.data)
          || !("sleepScore" in request.resource.data.healthProfile)
        );

      allow delete: if false;
    }

    // ─── preferences/{uid} ──────────────────────────────────────────────────
    match /preferences/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ─── cycleLogs/{uid}/entries/{dateKey} ──────────────────────────────────
    match /cycleLogs/{uid}/entries/{dateKey} {
      allow read, write: if isOwner(uid);
    }

    // ─── symptomLogs/{uid}/entries/{dateKey} ────────────────────────────────
    match /symptomLogs/{uid}/entries/{dateKey} {
      allow read, write: if isOwner(uid);
    }

    // ─── biometricLogs/{uid}/entries/{dateKey} ──────────────────────────────
    match /biometricLogs/{uid}/entries/{dateKey} {
      allow read, write: if isOwner(uid);
    }

    // ─── relationships/{relId} ──────────────────────────────────────────────
    match /relationships/{relId} {
      allow read: if isAuth() &&
        (resource.data.teenUid == request.auth.uid ||
         resource.data.guardianUid == request.auth.uid);
      allow write: if false;
    }

    // ─── consents/{consentId} ───────────────────────────────────────────────
    match /consents/{consentId} {
      allow read: if isAuth() &&
        (resource.data.teenUid == request.auth.uid ||
         resource.data.guardianUid == request.auth.uid);

      allow update: if isAuth() &&
        resource.data.guardianUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "statusUpdatedAt", "decidedAt", "scope"]);

      allow create: if false;
      allow delete: if false;
    }

    // ─── exports/{exportId} ─────────────────────────────────────────────────
    match /exports/{exportId} {
      allow read, write: if isAuth() && resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
    }

    // ─── auditLogs/{logId} ──────────────────────────────────────────────────
    match /auditLogs/{logId} {
      allow read: if isAdmin() ||
        (isAuth() && resource.data.actorUid == request.auth.uid);
      allow write: if false;
    }

    // ─── adminUsers/{uid} ───────────────────────────────────────────────────
    match /adminUsers/{uid} {
      allow read: if isAdmin() && request.auth.uid == uid;
      allow write: if false;
    }

    // ─── symptomLogs/{uid} ────────────────────────────────────────
    match /symptomLogs/{uid} {
      allow read, write: if isOwner(uid);
    }
    
    // ─── symptomCatalog/{symptomKey} ────────────────────────────────────────
    match /symptomCatalog/{symptomKey} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ─── clinicDirectory/{entryId} ──────────────────────────────────────────
    match /clinicDirectory/{entryId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ─── pamphlets/{pamphletId} ─────────────────────────────────────────────
    match /pamphlets/{pamphletId} {
      allow read: if isAuth() && resource.data.status == "published";
      allow write: if isAdmin();
    }

    // ─── deviceTokens/{tokenId} ─────────────────────────────────────────────
    match /deviceTokens/{tokenId} {
      allow read, write: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // ─── notificationsQueue/{notifId} ───────────────────────────────────────
    match /notificationsQueue/{notifId} {
      allow read, write: if false;
    }

    // ─── reports/{reportId} ─────────────────────────────────────────────────
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── guardianSummaries/{teenUid} ────────────────────────────────────────
    match /guardianSummaries/{teenUid} {
      allow read: if isOwner(teenUid) ||
        (isAuth() && hasActiveRelationship(teenUid, request.auth.uid));
      allow write: if false;
    }

    // ─── phaseFeedback/{uid}/entries/{entryId} ───────────────────────────────
    match /phaseFeedback/{uid}/entries/{entryId} {
      allow read, write: if isOwner(uid);
    }

    match /phaseFeedback/{uid}/entries/{entryId} {
      allow read, write: if isOwner(uid);
    }

    // ─── Deny everything else ───────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
        <mxCell id="MvcNote" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#35122f;fontSize=12;align=left;verticalAlign=top;spacing=8;" value="Reading this diagram: each row is one Bloom feature. The View delegates user actions to a frontend controller. The controller sends authenticated API requests through ApiClient. Express routes perform backend logic, read/write model data through FirestoreRepository, then return data for the View to render. The Model never directly controls the View." vertex="1">
          <mxGeometry height="115" width="590" x="65" y="1685" as="geometry" />
        </mxCell>
        <mxCell id="Legend" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#35122f;fontSize=12;align=left;verticalAlign=top;spacing=8;" value="Line legend&amp;#xa;--------------------&amp;#xa;Dashed open arrow: dependency / request&amp;#xa;Dotted return arrow: render/update response&amp;#xa;Solid open arrow: model mapping / result&amp;#xa;Rows are aligned to reduce crossing lines." vertex="1">
          <mxGeometry height="115" width="360" x="720" y="1685" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
